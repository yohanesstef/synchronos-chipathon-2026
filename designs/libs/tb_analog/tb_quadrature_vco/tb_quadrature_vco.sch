C {libs/core_analog/vco/vco.sym} 1920 -460 0 0 {name=x1}
C {devices/code_shown.sym} 5 -760 0 0 {name=Simulation only_toplevel=false value="
.param vbp=2.1 vbn=1.2 Vin=0 Vcm=2.5
.ic v(vop1)=3.3 v(von1)=0 v(startup)=0 v(vbp)=0
.param t1=1u t2=2u t3=3u t4=4u t5=5u t6=6u t7=10u t8=100u t9=1m tr=10n

.param d0=0 d1=0.35 d2=0.825 d3=1.2375
+d4=1.65 d5=2.0625 d6=2.475 d7=2.6 d8=2.75

vs startup 0 pulse(0 1 100n 10n 10n 100n 100m)
vctrl vctrl 0 pwl(0 d0 
+t1 d0 't1+tr' d1
+t2 d1 't2+tr' d2
+t3 d2 't3+tr' d3
+t4 d3 't4+tr' d4
+t5 d4 't5+tr' d5
+t6 d5 't6+tr' d6
+t7 d6 't7+tr' d7
+t8 d7 't8+tr' d8
+t9 d8 't9+tr' d0 R 0)

*vctrl vctrl 0 2.6

.control
set wr_singlescale
set wr_vecnames

save all

OP
show all

tran 10000p 1.01m
*DC V5 -1 1 0.01
*TRAN 10u

let sum = v(VOP1) + v(VON1)
let diff = v(VOP1) - v(VON1)
*let gain = deriv(diff)
let vcm = AVG(sum/2)


meas tran vmax MAX v(VOP1) FROM=10n TO=20n
meas tran vmin MIN v(VOP1) FROM=10n TO=20n
let vswing = vmax-vmin

meas tran I_tail_avg1 AVG i(v.x1.x1.vmeas2) FROM=1.01u TO=2u
meas tran I_tail_avg2 AVG i(v.x1.x1.vmeas2) FROM=2.01u TO=3u
meas tran I_tail_avg3 AVG i(v.x1.x1.vmeas2) FROM=3.01u TO=4u
meas tran I_tail_avg4 AVG i(v.x1.x1.vmeas2) FROM=4.01u TO=5u
meas tran I_tail_avg5 AVG i(v.x1.x1.vmeas2) FROM=5.01u TO=6u
meas tran I_tail_avg6 AVG i(v.x1.x1.vmeas2) FROM=6.01u TO=10u
meas tran I_tail_avg7 AVG i(v.x1.x1.vmeas2) FROM=10.01u TO=100u
meas tran I_tail_avg8 AVG i(v.x1.x1.vmeas2) FROM=100.01u TO=1m

meas tran I_VCO1 AVG i(V2) FROM=1.01u TO=2u
meas tran I_VCO2 AVG i(V2) FROM=2.01u TO=3u
meas tran I_VCO3 AVG i(V2) FROM=3.01u TO=4u
meas tran I_VCO4 AVG i(V2) FROM=4.01u TO=5u
meas tran I_VCO5 AVG i(V2) FROM=5.01u TO=6u
meas tran I_VCO6 AVG i(V2) FROM=6.01u TO=10u
meas tran I_VCO7 AVG i(V2) FROM=10.01u TO=100u
meas tran I_VCO8 AVG i(V2) FROM=100.01u TO=1m

remzerovec

write tb_quadrature_vco.raw
*wrdata /foss/designs/synchronos-chipathon-2026/designs/libs/tb_analog/tb_quadrature_vco/tb_quadrature_vco.csv tran.all
.endc
"}
